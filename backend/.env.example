# Copy to .env and adjust. All keys are prefixed WEAVE_ (except ANTHROPIC_API_KEY).

# --- LLM ---
# Backend: auto (Ollama->Anthropic->offline) | ollama | anthropic | offline
WEAVE_LLM_BACKEND=auto
WEAVE_FORCE_OFFLINE_LLM=false

# Ollama (fully local, no API key). Start `ollama serve` and pull a tool-capable
# model, e.g.:  ollama pull llama3.1
WEAVE_OLLAMA_HOST=http://host.docker.internal:11434
WEAVE_OLLAMA_MODEL=llama3.2:3b
# Optional local embeddings for retrieval (pull first: ollama pull nomic-embed-text)
WEAVE_OLLAMA_USE_EMBEDDINGS=false
WEAVE_OLLAMA_EMBED_MODEL=nomic-embed-text

# Anthropic (Claude) — only used when WEAVE_LLM_BACKEND is auto/anthropic and a key is set.
ANTHROPIC_API_KEY=
WEAVE_MODEL_TIER_FAST=claude-haiku-4-5-20251001
WEAVE_MODEL_TIER_FRONTIER=claude-opus-4-8

# --- security ---
WEAVE_SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- database (default: SQLite; production: Postgres+pgvector) ---
# WEAVE_DATABASE_URL=postgresql+psycopg://weave:weave@localhost:5432/weave

# --- sandbox ---
WEAVE_SANDBOX_BACKEND=subprocess      # subprocess | remote (gVisor/Firecracker service)
WEAVE_SANDBOX_TIMEOUT_SECONDS=30
WEAVE_SANDBOX_MEMORY_MB=512
# WEAVE_ANALYSIS_RUNNER_URL=https://analysis-runner.internal
# WEAVE_ANALYSIS_RUNNER_SECRET=...

# --- database (SQLite default; Postgres+pgvector via --profile full) ---
# WEAVE_DATABASE_URL=postgresql+psycopg://weave:weave@postgres:5432/weave

# --- background jobs / cache ---
# WEAVE_REDIS_URL=redis://redis:6379/0     # enables Celery dispatch (else inline)
WEAVE_JOB_MAX_RETRIES=3
WEAVE_JOB_RETRY_BASE_SECONDS=5

# --- observability (OpenTelemetry; no-op unless set) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- SMS OTP (Africa's Talking; 'log' just logs the code in dev) ---
WEAVE_SMS_PROVIDER=log            # log | africastalking
# WEAVE_AT_USERNAME=...
# WEAVE_AT_API_KEY=...
# WEAVE_AT_SENDER_ID=...

# --- WhatsApp channel (v2) ---
WEAVE_WA_VERIFY_TOKEN=weave-verify
# WEAVE_WA_APP_SECRET=...          # Meta app secret; verifies webhook POST signatures
# WEAVE_WA_TOKEN=...               # WhatsApp Cloud API token
# WEAVE_WA_PHONE_ID=...

# Enable only when clients cannot reach the API except through your proxy.
WEAVE_TRUST_PROXY_HEADERS=false
WEAVE_RATE_LIMIT_SESSION_PER_MIN=60

# The subprocess backend is for local development. Disable code execution in
# production until WEAVE_SANDBOX_BACKEND points at a real isolation boundary.
WEAVE_ANALYSIS_EXECUTION_ENABLED=true
# WEAVE_SANDBOX_BACKEND=remote
# WEAVE_ANALYSIS_RUNNER_URL=https://analysis-runner.internal
# WEAVE_ANALYSIS_RUNNER_SECRET=replace-with-a-separate-signing-secret
WEAVE_WORKSPACE_ENABLED=false
# Requires a separate, hardened runner; do not enable merely to bypass preflight.
WEAVE_ALLOW_WORKSPACE_IN_PRODUCTION=false

# --- S3-compatible storage (AWS, MinIO, etc.) ---
WEAVE_STORAGE_BACKEND=local       # local | s3
WEAVE_S3_BUCKET=weave-datasets
WEAVE_S3_REGION=af-south-1
# WEAVE_S3_ENDPOINT_URL=https://s3.example.invalid
# WEAVE_S3_ACCESS_KEY_ID=...
# WEAVE_S3_SECRET_ACCESS_KEY=...
WEAVE_S3_KEY_PREFIX=weave

# --- artifact lifecycle / per-turn safety ---
WEAVE_ARTIFACT_TTL_SECONDS=259200          # GC generated artifacts after 3 days
WEAVE_PDF_MAX_PAGES=250
WEAVE_PDF_MAX_TEXT_CHARS=2000000
WEAVE_PDF_PARSE_TIMEOUT_SECONDS=20
WEAVE_CRAWLER_MAX_QUEUED_URLS=2000
WEAVE_MAX_SANDBOX_RUNS_PER_TURN=6
WEAVE_MAX_WEB_CALLS_PER_TURN=12

# --- environment ---
WEAVE_ENVIRONMENT=dev
WEAVE_DEBUG=true
